rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserData(data) {
      return data.userId is string &&
        data.userId.size() > 0 &&
        data.userId.size() <= 128 &&
        data.updatedAt is number;
    }

    function isValidSyncVault(data) {
      return data.userId is string &&
        data.userId.size() > 0 &&
        data.userId.size() <= 128 &&
        data.encryptedPayload is string &&
        data.encryptedPayload.size() <= 10000000 &&
        data.timestamp is number;
    }

    function isValidGameScore(data) {
      return data.gameId is string &&
        data.gameId.size() > 0 &&
        data.gameId.size() <= 64 &&
        data.userId is string &&
        data.userId.size() > 0 &&
        data.userId.size() <= 128 &&
        data.score is number &&
        data.timestamp is number;
    }

    // User Data Collection (Settings, Files, Custom Apps, Desktop state, Game scores)
    match /obsidian_users_data/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId) && isValidUserData(request.resource.data);
      allow delete: if isValidId(userId);
    }

    // Encrypted Cloud Sync Vaults
    match /obsidian_sync_vaults/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId) && isValidSyncVault(request.resource.data);
      allow delete: if isValidId(userId);
    }

    // Global Game Scores & Leaderboards
    match /obsidian_game_scores/{scoreId} {
      allow read: if true;
      allow create, update: if isValidId(scoreId) && isValidGameScore(request.resource.data);
      allow delete: if false;
    }

    // App Store Cloud Catalog & Community Apps
    match /obsidian_app_store/{appId} {
      allow read: if true;
      allow create, update: if isValidId(appId) &&
        request.resource.data.appId is string &&
        request.resource.data.name is string;
      allow delete: if isValidId(appId);
    }
  }
}
